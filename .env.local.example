# Site URL for SEO (canonical base, sitemap, Open Graph). Production: https://www.riftbounty.com
# NEXT_PUBLIC_SITE_URL=https://www.riftbounty.com

# API base URL (e.g. http://localhost:3010/v1)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_USE_API_PROXY=true

# Card images CDN (R2 public URL); leave empty to use local /images
# NEXT_PUBLIC_IMAGES_CDN_URL=https://pub-xxxx.r2.dev
#
# Community avatars: uploaded via POST /v1/admin/communities/:id/avatar (multipart).
# The backend stores objects under communities/<uuid>.<ext> in the same R2 bucket / public base as documented in the API repo (docs/COMMUNITIES.md). Not configured in this Next app.

# Optional: set to "true" to log all backend requests in the Node terminal (via /api/proxy)
# NEXT_PUBLIC_USE_API_PROXY=true
